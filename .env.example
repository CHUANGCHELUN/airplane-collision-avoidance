# ─────────────────────────────────────────────
# 複製此檔為 .env 並填入真實值
# Copy this file to .env and fill in real values
# ─────────────────────────────────────────────

# HBase 伺服器 IP（私有雲 Master Node）
HBASE_HOST=192.168.x.x

# LINE Notify Token（前往 https://notify-bot.line.me 申請）
LINE_TOKEN=your_line_notify_token_here

# FlightAware AeroAPI 金鑰（查詢航班排程用）
FLIGHTAWARE_API_KEY=your_flightaware_api_key_here

# 主程式輸出的 JSON 路徑（供網頁前端讀取）
JSON_OUTPUT_PATH=/var/www/html/output.json

# Flask 伺服器設定
FLASK_HOST=0.0.0.0
FLASK_PORT=8081
